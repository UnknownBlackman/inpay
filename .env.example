# Testnet only. Copy to .env (gitignored).
NEAR_ACCOUNT_ID=yourname.testnet
# Private key of NEAR_ACCOUNT_ID (or leave empty and use ~/.near-credentials/testnet/<account>.json)
NEAR_PRIVATE_KEY=
# NEAR_RPC_URL=https://test.rpc.fastnear.com

